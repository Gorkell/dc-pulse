DATABASE_URL=sqlite:///data.sqlite3
HOST=127.0.0.1
PORT=8000
SIMULATOR_ENABLED=1
COOKIE_SECURE=0
# Set COOKIE_SECURE=1 behind HTTPS in production.
# PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/iot
# Production: set DEMO_PASSWORD outside Git. Session tokens use secrets.token_urlsafe.
# DEMO_PASSWORD is required to seed users when COOKIE_SECURE=1.
